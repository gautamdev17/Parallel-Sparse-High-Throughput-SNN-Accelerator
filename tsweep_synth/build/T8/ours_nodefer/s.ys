read_verilog -sv ../../../rtl/ours/ours_core.v
hierarchy -top ours_core
synth -top ours_core
delete t:$print t:$check
opt_clean
dfflibmap -liberty ../../../lib/NangateOpenCellLibrary_typical.lib
