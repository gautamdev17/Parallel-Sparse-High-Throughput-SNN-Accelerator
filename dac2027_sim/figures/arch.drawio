="30" as="geometry"/></mxCell><mxCell id="c280" value="Filters share a column when their non-zero weights never fall in the same row (offline). Pixels share a group when their spikes never fall on the same (row, timestep) bit (run time). Labels route every addition, so no PE searches or compares." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;fontStyle=0;rotation=0;" vertex="1" parent="1"><mxGeometry x="518" y="646" width="470" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>